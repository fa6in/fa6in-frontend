{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http:/142.93.114.200/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "http://142.93.114.200/media/$1"
    },
    {
      "source": "/((?!api|media).*)",
      "destination": "/index.html"
    }
  ]
}
