{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "http://159.223.114.190/api/$1"
    },
    {
      "src": "^/media/(.*)$",
      "dest": "http://159.223.114.190/media/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
