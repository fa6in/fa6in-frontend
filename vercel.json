{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://159.223.114.190/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "http://159.223.114.190/media/$1"
    },
    {
      "source": "/((?!api|media).*)",
      "destination": "/index.html"
    }
  ]
}